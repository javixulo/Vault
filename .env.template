# Copy this file to `.env` (same folder as docker-compose.yml) and set the real values. `.env` is git-ignored: never commit it.
#   Copy-Item .env.template .env
# In a stack editor such as Portainer's, set the same variables in its "Environment variables" section instead.

# --- Required ---------------------------------------------------------------------------------------------------------
# Address of the OMV web interface, no trailing path. Vault adds /rpc.php.
VAULT_OMV_URL=https://nas.local

# The OMV account Vault logs in with: a dedicated user in the group openmediavault-admin (README, "Set up the OMV account").
VAULT_OMV_USERNAME=vault-mcp

# Its password. It becomes a Docker secret inside the container (it is never an environment variable there), but it is
# plain text in THIS file: keep `.env` readable only by you. With a `$` or `#` in it, put the value in single quotes.
VAULT_OMV_PASSWORD='replace-me'

# --- Optional ---------------------------------------------------------------------------------------------------------
# Version of the image to run (required): an exact version, so updates happen on purpose. `latest` is the newest stable one.
VAULT_VERSION=0.1.0-beta.1

# Accept a self-signed TLS certificate from OMV (OMV ships one). `false` is the safe default; `true` lets anyone on the
# network impersonate OMV and receive the account's password. Only turn it on on a network you trust.
VAULT_ALLOW_INVALID_CERTIFICATE=false

# Port Vault listens on, on this machine.
VAULT_PORT=7842

# User and group the container runs as (any works: the secret is readable by everyone inside the container).
VAULT_UID=1000
VAULT_GID=1000

TZ=Europe/Madrid
