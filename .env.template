# Copy this file to `.env` (same folder) and set the real values. `.env` is git-ignored: never commit it.
#   Copy-Item .env.template .env
#
# This file is for NON-secret settings only. The OMV password does NOT go here: an environment variable is visible with
# `docker inspect`. The account lives in a separate file, secrets/omv_credentials.json (see secrets/omv_credentials.example.json),
# which compose mounts as a Docker secret.

# Address of the OMV web interface, no trailing path. Required. Vault adds /rpc.php.
VAULT_OMV_URL=https://nas.local

# Accept a self-signed TLS certificate from OMV (OMV ships one). `false` is the safe default; `true` lets anyone on the
# network impersonate OMV and receive the account's password. Only turn it on on a network you trust.
VAULT_ALLOW_INVALID_CERTIFICATE=false

# Port Vault listens on, on this machine.
VAULT_PORT=8080

# User and group the container runs as. It must be able to read secrets/omv_credentials.json (check with `id -u` and `id -g`
# on Linux; on Docker Desktop for Windows the defaults are fine).
VAULT_UID=1000
VAULT_GID=1000

# Optional.
TZ=Europe/Madrid
VAULT_ENVIRONMENT=production
# OTEL_EXPORTER_OTLP_ENDPOINT=http://seq:5341/ingest/otlp
