<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Docker image running, spoken to as a client would (technical spec, section 8). No reference to the code: the
       only way in is the MCP endpoint of the container. The stand-in of OMV runs inside the test process (tests/shared). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\FakeOmvServer.cs" Link="shared\FakeOmvServer.cs" />
  </ItemGroup>

</Project>
